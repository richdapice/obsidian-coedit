<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.richdapice.coedit-claude</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>PEER_DIR/peer.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>PEER_DIR</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>PEER_DIR/peer.log</string>
  <key>StandardErrorPath</key><string>PEER_DIR/peer.log</string>
</dict>
</plist>
